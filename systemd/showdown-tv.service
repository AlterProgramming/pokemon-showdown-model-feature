[Unit]
Description=Showdown TV continuous battle runner
After=docker.service
Requires=docker.service

[Service]
Type=simple
ExecStartPre=-/usr/bin/docker rm -f showdown_tv
ExecStart=/usr/bin/docker run --name showdown_tv --rm \
  --network traefik_default \
  -v /srv/showdown/data/logs:/app/logs \
  -e MODEL_A_ENDPOINT=http://model-server:5000/predict \
  -e MODEL_B_ENDPOINT=http://model-server:5000/predict \
  -e MODEL_A_ID=model1 \
  -e MODEL_B_ID=model4 \
  -e MODEL_A_NAME=Model1 \
  -e MODEL_B_NAME=Model4 \
  -e MODEL_A_PROFILE=joint-policy \
  -e MODEL_B_PROFILE=joint-policy-value \
  -e REPLAY_OUTPUT_DIR=/app/logs/tv \
  -e TV_REFRESH_SECONDS=60 \
  showdown-showdown:latest node dist/sim/examples/tv-runner.js
ExecStop=/usr/bin/docker stop showdown_tv
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
